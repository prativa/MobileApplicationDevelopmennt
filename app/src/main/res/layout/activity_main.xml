<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2"
    android:orientation="vertical"
    android:padding="120dp"
    >

    <TextView
        android:id="@+id/textViewIntentLable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:text="Start using new activity using intent"/>

    <Button
        android:id="@+id/buttonInternalIntent"
        android:text="Click here to start new activity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <Button
        android:text="Click here to share"

        android:id="@+id/buttonExternalIntent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>